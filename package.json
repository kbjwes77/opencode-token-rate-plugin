{
  "name": "opencode-token-rate-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode TUI plugin: a sparkline in the session sidebar footer cycling through tokens-per-second and per-minute token usage views, with current/average/max stats.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "tokens-per-second",
    "token-usage",
    "sparkline"
  ],
  "license": "MIT",
  "author": "John <kbjwes77@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbjwes77/opencode-token-rate-plugin.git"
  },
  "exports": {
    ".": "./server.ts",
    "./tui": "./tui.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run -r ./scripts/preload.ts ./scripts/check.ts",
    "check:render": "bun run -r ./scripts/preload.ts --conditions=browser ./scripts/render.tsx"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.31"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/theme": "2.0.31",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/node": "^24.19.2",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  }
}
